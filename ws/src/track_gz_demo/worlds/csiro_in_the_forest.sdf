<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <!-- simple directional light (avoids needing model://sun) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <direction>-0.5 0.5 -1</direction>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </light>

   
    <include>
      <name>Forest</name>
      <uri>model://Forest</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>


    <include>
      <name>CSIRO</name>
      <uri>model://CSIRO_DATA61_OZBOT_ATR_SENSOR_CONFIG_2</uri>
      <!-- start a bit above the floor so it doesn't clip -->
      <pose> 0 0 1.2 0 0 0</pose>
    </include>


    <include>
      <name>GroundPlane</name>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Ground%20Plane</uri>
      <pose>0 0 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>